#!/usr/bin/env bash

if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi

watch_file flake.nix
watch_file flake.lock

mkdir -p "$PWD/.devenv"
DEVENV_ROOT_FILE="$PWD/.devenv/root"
printf %s "$PWD" >"$DEVENV_ROOT_FILE"

if ! use flake .#dev-nix --override-input devenv-root "file+file://$DEVENV_ROOT_FILE"; then
  echo "devenv could not be built. The devenv environment was not loaded." >&2
fi
