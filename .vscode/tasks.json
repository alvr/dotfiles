{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Upload dotfiles",
      "type": "shell",
      "command": "rclone",
      "args": [
        "sync",
        "--exclude",
        "/.git/**",
        "${workspaceFolder}",
        "apeiron:/nix/persist/dotfiles",
        "-v",
        "--progress",
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
      },
    },
  ],
}
